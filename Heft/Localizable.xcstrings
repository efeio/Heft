        }
      },
      "comment": "Insight gain distance message"
    },
    "Kilo alma modunda artışlar pozitif olarak değerlendirilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In weight gain mode, increases are celebrated as positive progress."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo alma modunda artışlar pozitif olarak değerlendirilir."
          }
        }
      },
      "comment": "Goal gain explanation"
    },
    "Kilo geçmişini ve değişim istatistiklerini görmek için ilk tartımını ekle.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first weigh-in to view your weight history and progress statistics."
