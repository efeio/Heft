        }
      },
      "comment": "Weight chart summary accessibility label"
    },
    "Kilo koruma modunda mevcut kilonu dengede tutman hedeflenir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In maintenance mode, the focus is keeping your current weight steady."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo koruma modunda mevcut kilonu dengede tutman hedeflenir."
          }
        }
      },
      "comment": "Goal maintain explanation"
    },
    "Kilo trendini ve değişim grafiğini görebilmek için en az 2 ölçüm gerekiyor. Bir sonraki tartında ilerlemen burada canlanacak.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least 2 entries are required to display your weight trend and progress chart. Your progress will appear here after your next weigh-in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo trendini ve değişim grafiğini görebilmek için en az 2 ölçüm gerekiyor. Bir sonraki tartında ilerlemen burada canlanacak."
          }
        }
      },
      "comment": "Single entry chart explanation"
    },
    "Kilo verme hedefi için hedef kilon mevcut kilondan düşük olmalıdır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a weight loss goal, your target weight must be lower than your current weight."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo verme hedefi için hedef kilon mevcut kilondan düşük olmalıdır."
          }
        }
      },
      "comment": "Goal lose validation error"
    },
    "Kilo verme modunda azalışlar başarı olarak değerlendirilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In weight loss mode, decreases are celebrated as progress."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo verme modunda azalışlar başarı olarak değerlendirilir."
          }
        }
      },
      "comment": "Goal lose explanation"
    },
    "Kilon %lld gündür %@ ± 0,4 kg bandında dengeleniyor. Bu normal bir adaptasyon evresidir; metabolizman alıştığında tempon yeniden hareketlenecektir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For %lld days, your weight has plateaued around %@ ± 0.4 kg. This is a normal adaptation phase; your pace will pick back up as your metabolism adjusts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilon %lld gündür %@ ± 0,4 kg bandında dengeleniyor. Bu normal bir adaptasyon evresidir; metabolizman alıştığında tempon yeniden hareketlenecektir."
          }
