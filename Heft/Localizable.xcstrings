    "%@ cm boy için normal BMI (18,5 - 24,9) aralığı %@ - %@ kg arasındadır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For %@ cm height, the normal BMI range (18.5 - 24.9) is %@ - %@ kg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm boy için normal BMI (18,5 - 24,9) aralığı %@ - %@ kg arasındadır."
          }
        }
      },
      "comment": "Healthy weight range message"
    },
    "%@ hedefine başarıyla ulaştın. Formunu korumak için aynı kararlılıkla devam et.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've successfully reached your %@ goal. Keep up the consistency to maintain your form."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hedefine başarıyla ulaştın. Formunu korumak için aynı kararlılıkla devam et."
          }
        }
      },
      "comment": "Insight goal reached gain msg"
    },
    "%@ hedefine ulaştın. Sağlıklı kilonu korumak için aynı kararlılıkla devam et.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached your %@ goal. Keep up the consistency to maintain your healthy weight."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hedefine ulaştın. Sağlıklı kilonu korumak için aynı kararlılıkla devam et."
          }
        }
      },
      "comment": "Insight goal reached lose msg"
    },
    "%@ kg hedefine ulaştığında BMI değerin %@ (%@) olacak. Boyun için sağlıklı kilo aralığı %@ - %@ kg'dır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you reach your %@ kg goal, your BMI will be %@ (%@). The healthy weight range for your height is %@ - %@ kg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kg hedefine ulaştığında BMI değerin %@ (%@) olacak. Boyun için sağlıklı kilo aralığı %@ - %@ kg'dır."
          }
        }
      },
      "comment": "Target BMI explanation"
    },
    "%@ kilogram": {
      "localizations": {
