    "%@ tarihine ait mevcut kayıt (%@), yeni değer olan %@ ile güncellenecektir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The existing entry for %@ (%@) will be updated with the new value of %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihine ait mevcut kayıt (%@), yeni değer olan %@ ile güncellenecektir."
