    "Kilo alma hedefi için hedef kilon mevcut kilondan yüksek olmalıdır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a weight gain goal, your target weight must be higher than your current weight."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo alma hedefi için hedef kilon mevcut kilondan yüksek olmalıdır."
