        }
      },
      "comment": "Goal gain validation error"
    },
    "Kilo alma hedefine ulaşmak için %@ mesafe var. Düzenli tartılarak ilerlemeni takip et.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %@ away from your weight gain goal. Track your progress with regular weigh-ins."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo alma hedefine ulaşmak için %@ mesafe var. Düzenli tartılarak ilerlemeni takip et."
